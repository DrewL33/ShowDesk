{
  "name": "showdesk",
  "version": "0.1.0",
  "private": true,
  "description": "ShowDesk local web application for live-production engineering observability.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "check": "node --check src/server.js && node --check public/transport.js",
    "bundle": "esbuild src/server.js --bundle --platform=node --format=cjs --outfile=dist/server.cjs"
  },
  "dependencies": {
    "atem-connection": "^3.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}