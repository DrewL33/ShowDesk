{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShowDesk",
  "version": "0.1.0",
  "identifier": "app.showdesk.beta",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "title": "ShowDesk",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
